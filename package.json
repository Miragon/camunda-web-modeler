{
  "name": "@miragon/camunda-web-modeler",
  "version": "0.2.0",
  "description": "A browser-native BPMN and DMN modeler based on bpmn.io.",
  "author": "Miragon GmbH <info@miragon.io>",
  "homepage": "https://github.com/Miragon/camunda-web-modeler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/camunda-web-modeler.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "vite example",
    "docs": "typedoc src --exclude src/types --exclude src/components --exclude src/bpmnio --exclude \"src/**/*.test.ts\" --exclude \"src/**/*.test.tsx\" --disableSources --out dist/docs",
    "watch": "tsc -w",
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/build-styles.mjs",
    "lint:package": "publint --level error",
    "lint": "eslint -c eslint.config.mjs . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p example/tsconfig.json && node scripts/check-readme-examples.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write src example scripts .github \"*.{mjs,json}\"",
    "format:check": "prettier --check src example scripts .github \"*.{mjs,json}\""
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "miragon",
    "modeler",
    "camunda",
    "bpmnio",
    "bpmn",
    "dmn"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/docs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./bpmn.css": "./dist/bpmn.css",
    "./dmn.css": "./dist/dmn.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/editor/XmlEditor.js"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@bpmn-io/element-template-chooser": "3.0.0",
    "@bpmn-io/properties-panel": "3.56.1",
    "@emotion/react": "11.14.0",
    "@monaco-editor/react": "4.7.0",
    "bpmn-js": "18.31.0",
    "bpmn-js-element-templates": "2.37.1",
    "bpmn-js-properties-panel": "5.65.1",
    "camunda-bpmn-moddle": "8.0.2",
    "camunda-dmn-moddle": "1.3.1",
    "deepmerge": "4.3.1",
    "diagram-js": "15.28.0",
    "diagram-js-origin": "1.4.1",
    "dmn-js": "17.12.2",
    "dmn-js-properties-panel": "3.12.0",
    "tss-react": "4.9.21"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.24.8",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "monaco-editor": "0.57.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "6.1.3",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.55.0 <1",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "resolutions": {
    "dompurify": "3.4.16"
  },
  "packageManager": "yarn@4.16.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "yarn",
      "version": "4.16.0",
      "onFail": "warn"
    }
  }
}
