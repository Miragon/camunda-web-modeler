root = true

# Formatting is done by Prettier (.prettierrc); this only sets editor defaults that
# match it.
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
max_line_length = 89
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
